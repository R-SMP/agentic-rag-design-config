# --- Secrets (NEVER commit these) ---
.env
*.env
!.env.example
!*.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Runtime artefacts (generated by the system) ---
web/render_samples/
logs/
attempts/
database/
previous_sessions/
inputs/input_images/*
!inputs/input_images/.gitkeep
inputs/user_query.txt
inputs/extracted_inputs.txt

# --- Prompt-fragment snapshot backups ---
prompts_backup_*/

# --- Prompt-matrix snapshots: the full prompt texts stay local; only the
#     fingerprints (extra_utilities/prompt_matrix/baseline_manifest.json)
#     are committed ---
extra_utilities/prompt_matrix/snapshots/

# --- Developer-local DH question schedule (edited via the "Questions
#     for Saved Sessions" web view).  Seeded from the hardcoded
#     SCHEDULE on first load; the file represents the developer's
#     personal customisations and should not be committed. ---
# The DH question schedule is per-topology; each topology has its own
# runtime file seeded from its own tracked default.
workflow_settings/dh_schedule.json
workflow_settings/dh_schedule_5agents.json
workflow_settings/dh_schedule_3agents.json
# Workflow Settings saved on this computer (the tools' settings, who sees the
# parameter list, the per-agent OCR "Crops" toggles): this computer's choices.
workflow_settings/tool_settings.json
workflow_settings/parameter_access.json
workflow_settings/ocr_region_crops_access.json

# --- Claude Code (per-user) ---
.claude/settings.local.json
# Local-only launch.json for the Claude Code preview server.  Path
# entries inside it (Python interpreter, port) are developer-
# specific, so the file must NEVER be uploaded.
.claude/launch.json
# Local-only session bootstrap pointer — must NEVER be uploaded.
CLAUDE.md

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
node_modules/
package-lock.json
render_try/
