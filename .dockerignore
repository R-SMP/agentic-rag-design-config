# Files and directories excluded from the docker build context.
# Without this file, ``COPY . ./`` would copy the developer's local
# .venv (~hundreds of MB), git history, session artefacts, log
# files, and potentially private user inputs into the image.

# --- Python / venv -------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node --------------------------------------------------------------
# The FEG geometry backend's npm deps are installed reproducibly inside
# the image (Dockerfile ``npm install`` against package.json).  Keep the
# developer's local node_modules OUT of the build context so it can't
# overlay the image's install or bloat the context.
node_modules/

# --- Git & editor metadata ----------------------------------------
.git/
.gitignore
.gitattributes
.github/
.claude/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Session-time artefacts (regenerated on every run) ------------
# These directories exist on the developer's machine but should NOT
# end up baked into the image — they may contain private user
# inputs, generated renders from past sessions, or large mesh files.
logs/
attempts/
inputs/
previous_sessions/
database/

# --- Local config & secrets ---------------------------------------
.env
.env.*
!.env.example

# --- Docs / development scaffolding -------------------------------
# extra_utilities/ is still copied into the image, although the web
# app runs nothing from it since MAS-blueprint P4c (the Render-compression
# panel's samples come from engine/image_run.py).  Strip only the ad-hoc
# files that should never run server-side.
prompts_backup_*/

# --- The Studio -------------------------------------------------------
# The image carries the Studio: the web app serves it at /studio/
# (studio/embedded.py), or it runs as a service of its own (python -m studio
# --online, studio/HOSTING.md).  Its shared setup, workspace/, is never
# baked in.
workspace/
# A configurator kept out of the repository and the images: the vacuum hose
# adapter's model asks not to be hosted or uploaded (setups/README.md).
setups/vacuum_hose_adapter/

# --- Containerisation metadata ------------------------------------
# No need to recursively include the Dockerfile / compose file
# inside the image itself.
Dockerfile
docker-compose.yml
.dockerignore
